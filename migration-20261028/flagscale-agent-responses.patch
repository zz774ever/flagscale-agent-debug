+def test_cli_yaml_and_factory_select_responses(tmp_path, monkeypatch):
+    import sys
+    from unittest.mock import MagicMock
+
+    path = tmp_path / "agent.yaml"
+    path.write_text("provider: openai\nmodel: test-model\napi_key: test-key\nopenai_api: responses\n")
+    monkeypatch.setenv("FLAGSCALE_HOME", str(tmp_path))
+    worker = MagicMock()
+    monkeypatch.setitem(sys.modules, "flagscale_agent.react.agent", SimpleNamespace(WorkerAgent=worker))
+    result = CliRunner().invoke(app, ["--config", str(path), "hello"])
+    assert result.exit_code == 0, result.output
+    assert worker.call_args.args[0].openai_api == "responses"
+    result = CliRunner().invoke(app, ["--config", str(path), "--openai-api", "chat_completions", "hello"])
+    assert result.exit_code == 0, result.output
+    assert worker.call_args.args[0].openai_api == "chat_completions"
+    provider = get_provider("openai", "test", "key", openai_api="responses")
+    assert provider._api_type == "responses"
+    provider._client.close()
+    with pytest.raises(ValueError, match="openai_api"):
+        AgentConfig(openai_api="invalid")
